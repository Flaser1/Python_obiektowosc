

from models import PaymentOrder
from decimal import Decimal, InvalidOperation


def order_from_raw(raw_order: dict):
    required_keys = {"id": str, "amount": str, "status": str}
    for key in required_keys:
        if key not in raw_order:
            raise KeyError(f"{key} is missing")
        if type(raw_order[key]) is not type(key):
            raise TypeError(f"{key} must be str")
    order_id = raw_order["id"]
    amount = raw_order["amount"]
    status = raw_order["status"]
    order_id = int(order_id)
    try:
        amount = Decimal(amount.strip().replace(",", "."))
    except InvalidOperation as exc:
        raise ValueError(f"invalid amount: {amount!r}") from exc
    order = PaymentOrder(order_id, amount, status)
    return order

