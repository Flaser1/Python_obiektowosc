

from models import Customer

def normalize_customers(customers: list[dict]) -> list[Customer]:
    clean_customers = []
    for customer in customers:
        customer_id = customer["customer_id"]
        clean_name = customer["name"].strip()
        clean_country = customer["country"].strip().upper()
        if customer["email"] is None:
            clean_email = "missing_email"
        else:
            clean_email = customer["email"].strip().lower()
        clean_customer = {
            "customer_id": customer_id,
            "name": clean_name,
            "country": clean_country,
            "email": clean_email,
        }
        clean_customers.append(clean_customer)
    return build_customer_objects(clean_customers)

def build_customer_objects(customer_dicts: list[dict]) -> list[Customer]:
    customer_obj_list = []
    for customer in customer_dicts:
        customer_obj = Customer(customer["customer_id"], customer["name"], customer["country"], customer["email"])
        customer_obj_list.append(customer_obj)
    return customer_obj_list
