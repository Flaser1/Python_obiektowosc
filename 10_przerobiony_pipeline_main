

from source_data import customers, orders
from transformations import normalize_customers, build_order_objects
from metrics import build_country_report, build_customer_summary, build_all_summaries
from reporting import print_country_report

def main():
    clean_customers = normalize_customers(customers)
    obj_orders = build_order_objects(orders)
    summary = build_customer_summary(clean_customers[0], obj_orders)
    report = build_country_report(clean_customers, obj_orders)
    print(summary)
