class Product:
    def __init__(self, sku: str, unit_price: Decimal) -> None:
        if not isinstance(sku, str):
            raise TypeError("sku must be text")
        if sku.strip() == "":
            raise ValueError("sku cant be empty")
        if not isinstance(unit_price, Decimal):
            raise TypeError("unit_price must be Decimal")
        if not unit_price.is_finite() or unit_price < 0:
            raise ValueError("unit_price must be finite and positive")
        self.sku = sku.strip().upper()
        self.unit_price = unit_price

    def line_value(self, quantity: int) -> int:
        if type(quantity) is not int:
            raise TypeError("quantity must be int")
        self.quantity = quantity
        return self.unit_price * self.quantity

    def __repr__(self) -> str:
        return f"SKU={self.sku} unit_price={self.unit_price}"

